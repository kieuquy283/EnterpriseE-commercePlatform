        <mxCell id="note-0" value="&lt;b style='font-size:21px'&gt;Đọc đầy đủ ở ba trang chi tiết&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cart–Order: R1–R5, R10–R18, gồm FK totals_id lịch sử.&lt;br&gt;&lt;br&gt;Payment: R19–R27; R25 chỉ 0..1 với payment chưa xóa.&lt;br&gt;&lt;br&gt;Inventory: R6–R9, R28–R30; Variant–Inventory là N:N.&lt;br&gt;&lt;br&gt;Tổng toàn bộ: 12 FK, 8 cạnh LINK, 10 cạnh REF.&lt;br&gt;&lt;br&gt;Mỗi bảng là một đối tượng có thể chỉnh sửa trong draw.io." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fillColor=#f8fafc;strokeColor=#cbd5e1;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="1540" width="820" height="280" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Số đầu cạnh: 1 / 0..1 / 0..N. LINK/REF không có FK; ID NOT NULL không bảo đảm bản ghi đích tồn tại.&lt;br&gt;Với LINK, 0..N là số bản ghi bảng nối DB có thể lưu; cardinality API ghi riêng. PK cặp không cưỡng chế 1:1. R25: unique chỉ với payment chưa xóa.&lt;br&gt;Nguồn: catalog 24/10/2026 cho 20 bảng; Customer/Product từ snapshot v1 17/10/2026; Medusa 2.21.2. Bản vẽ 25/10/2026.&lt;br&gt;Các cột chọn lọc; không thay thế schema đầy đủ. Chưa chạy checkout trong công việc ERD. Xem medusa-erd-v2-business.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="2037" width="2660" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
