STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-long-random-secret
COOKIE_SECRET=replace-with-another-long-random-secret
DATABASE_URL=postgresql://commerce:commerce-local-only@localhost:5432/commerce
# Optional external S3 storage: configure S3_BUCKET, S3_ACCESS_KEY_ID,
# S3_SECRET_ACCESS_KEY, S3_FILE_URL, and optionally S3_ENDPOINT/S3_REGION.
# On ECS, use S3_AUTHENTICATION_METHOD=s3-iam-role instead of access keys.
# With a private BucketOwnerEnforced bucket, set S3_DISABLE_ACL=true.
# S3_REGION=ap-southeast-2
# To serve public product images through this backend with private S3:
# S3_PUBLIC_IMAGE_PROXY=true
# S3_FILE_URL=https://api.example.com/product-images
# Uploads use the public-images/ key prefix. Everything in that prefix is public
# through the proxy; keep private documents in a separate bucket/provider.
# Use flat upload filenames; directory-style filenames are not supported.
# Only JPEG, PNG, WebP, GIF and AVIF files are served.

# With host processes, export LOG_LEVEL=info before starting Medusa.
ENABLE_RECOMMENDATIONS=false
# Private pilot only. Keep disabled until consent, erasure and release gates pass.
ENABLE_PERSONALIZED_RECOMMENDATIONS=false
ENABLE_PERSONALIZATION_EVENTS=false
ENABLE_PERSONALIZATION_ORDER_EVENTS=false
ENABLE_PERSONALIZATION_PROFILE_JOB=false
PERSONALIZATION_MAX_CONCURRENCY=4
