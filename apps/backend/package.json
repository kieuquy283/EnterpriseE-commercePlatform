{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "cross-env NODE_PATH=./node_modules medusa build",
    "start": "cd .medusa/server && cross-env NODE_PATH=../../node_modules NODE_ENV=production node --env-file-if-exists=../../.env ../../../../node_modules/@medusajs/cli/cli.js start",
    "dev": "cross-env NODE_PATH=./node_modules medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:integration:http",
    "test:integration:http": "cross-env NODE_PATH=./node_modules TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "cross-env NODE_PATH=./node_modules TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "cross-env NODE_PATH=./node_modules TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "seed": "cross-env NODE_PATH=./node_modules medusa exec ./src/scripts/seed-commerce.ts",
    "seed:daymark-catalog": "cross-env NODE_PATH=./node_modules medusa exec ./src/scripts/seed-daymark-catalog.ts --",
    "seed:sample": "cross-env NODE_PATH=./node_modules medusa exec ./src/scripts/seed-erd-sample.ts",
    "check:inventory-order": "cross-env NODE_PATH=./node_modules medusa exec ./src/scripts/check-inventory-order.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.7",
    "@medusajs/admin-shared": "2.22.7",
    "@medusajs/caching": "2.22.7",
    "@medusajs/caching-redis": "2.22.7",
    "@medusajs/cli": "2.22.7",
    "@medusajs/cloud": "2.22.7",
    "@medusajs/dashboard": "2.22.7",
    "@medusajs/draft-order": "2.22.7",
    "@medusajs/framework": "2.22.7",
    "@medusajs/js-sdk": "2.22.7",
    "@medusajs/medusa": "2.22.7",
    "@medusajs/ui": "4.2.14",
    "@tanstack/react-query": "5.64.2",
    "nodemailer": "10.6.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.22.7",
    "@swc/core": "1.16.20",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "npm@11.12.1"
}
