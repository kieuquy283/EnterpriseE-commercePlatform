{
  "name": "enterprise-commerce-platform",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:seed:sample": "npm run seed:sample --workspace @dtc/backend",
    "backend:check:inventory-order": "npm run check:inventory-order --workspace @dtc/backend --",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "test:e2e": "turbo test:e2e",
    "docs:check": "node scripts/check-docs.mjs",
    "todo": "node scripts/list-todos.mjs",
    "presentation:dev": "npm run dev --workspace=presentation",
    "presentation:build": "npm run build --workspace=presentation",
    "presentation:test": "npm run test --workspace=presentation",
    "format:check": "oxfmt --check --config .oxfmtrc.json .oxfmtrc.json lint-staged.config.mjs",
    "hooks:install": "husky",
    "hooks:verify": "lint-staged --hide-unstaged --concurrent false",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production' && process.env.CI !== 'true' && require('node:fs').existsSync('.git')) import('husky').then(({default: husky}) => husky())\"",
    "format": "oxfmt --write --config .oxfmtrc.json"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "ajv": "^8.13.0",
    "eslint": "^9.39.4",
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "16.4.0",
    "oxfmt": "0.78.0",
    "react": "^19.0.5",
    "react-dom": "^19.0.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**",
    "presentation"
  ],
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  }
}
